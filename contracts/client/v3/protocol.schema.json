  "$id": "urn:opensquilla:client-contract:v3",
  "$ref": "#/$defs/Frame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Machine-valid protocol-v3 frame schema with descriptive baseline metadata.",
  "title": "OpenSquilla Gateway client protocol v3 baseline",
  "x-opensquilla-contract": {
    "connect": {
      "accepted_currently": {
        "auth": "non-object values are treated as an empty object",
        "client": "accepted but not validated or consumed",
        "id": "optional; scalar ids are stringified and other values use 'handshake'",
        "maxProtocol": "optional integer excluding booleans; defaults to 3",
        "minProtocol": "optional integer excluding booleans; defaults to 1",
        "params": "non-object values are treated as an empty object",
        "required_frame_fields": [
          "method=connect",
          "type=req"
        ],
        "role": "non-string values fall back to operator",
        "scope_claims": "accepted but authorization scopes come from the resolved principal",
        "version_lower_bound": "the current parser does not reject values below 1; canonical clients must use the advertised supported range"
      },
      "canonical_client_frame": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "method": {
            "const": "connect"
          },
          "params": {
            "additionalProperties": true,
            "properties": {
              "auth": {
                "type": "object"
              },
              "client": {
                "additionalProperties": true,
                "type": "object"
              },
              "maxProtocol": {
                "maximum": 3,
                "minimum": 1,
                "type": "integer"
              },
              "minProtocol": {
                "maximum": 3,
                "minimum": 1,
                "type": "integer"
              },
              "role": {
                "type": "string"
              },
              "scopes": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "type": {
            "const": "req"
          }
        },
        "required": [
          "type",
          "id",
          "method",
          "params"
        ],
        "type": "object"
      },
      "live_parser_model": {
        "schema": {
          "$ref": "#/$defs/ConnectParams"
        },
        "status": "used-by-websocket-parser",
        "wire_aliases": "min_protocol/max_protocol serialize as minProtocol/maxProtocol"
      },
      "sequence": [
        "server event connect.challenge",
        "client request connect",
        "server hello-ok or error response followed by close"
      ]
    },
    "errors": {
      "declared_codes": [
        "AGENT_TIMEOUT",
        "APPROVAL_NOT_FOUND",
        "INVALID_REQUEST",
        "METHOD_NOT_FOUND",
        "NOT_FOUND",
        "NOT_LINKED",
        "NOT_PAIRED",
        "UNAUTHORIZED",
        "UNAVAILABLE"
      ],
      "open_set": true,
      "schema": {
        "$ref": "#/$defs/ErrorShape"
      }
    },
    "frames": {
      "client_to_server_declared": {
        "$ref": "#/$defs/ClientFrame"
      },
      "server_to_client": {
        "$ref": "#/$defs/ServerFrame"
      }
    },
    "hello": {
      "features_events_completeness": "declared-stable-subset",
      "features_methods_source": "locked-rpc-registry",
      "schema": {
        "$ref": "#/$defs/HelloOk"
      },
      "snapshot_uptime_ms_current_semantics": "epoch-milliseconds-despite-field-name"
    },
    "limits": {
      "max_buffered_bytes": {
        "advertised_in_hello": true,
        "application_enforced": false,
        "value": 52428800
      },
      "max_payload_bytes": {
        "advertised_in_hello": true,
        "application_enforced": false,
        "value": 26214400
      },
      "max_preauth_payload_bytes": {
        "advertised_in_hello": false,
        "application_enforced": false,
        "status": "defined-only",
        "value": 65536
      },
      "transport_frame_limit": {
        "source": "ASGI-server/backend default; Gateway does not pin a value",
        "value": null
      },
      "writer_queue": {
        "unit": "frames-not-bytes",
        "value_source": "GatewayConfig.ws_writer_queue_maxsize"
      }
    },
    "other_declared_defaults": {
      "dedupe_max_entries": {
        "status": "defined-only",
        "value": 1000
      },
      "websocket_close_service_restart": 1012
    },
    "protocol": {
      "current": 3,
      "maximum_supported": 3,
      "minimum_supported": 1
    },
    "runtime_validation": {
      "inbound": "frame shape checks plus Pydantic parsing of connect.params",
      "outbound": "Pydantic response/event/hello serialization"
    },
    "schema_version": 1,
    "timing_defaults_ms": {
      "agent_stream_heartbeat": {
        "advertised_in_hello": true,
        "value": 15000
      },
      "agent_stream_idle": {
        "advertised_in_hello": true,
        "value": 600000
      },
      "client_ws_keepalive": {
        "advertised_in_hello": true,
        "enforced": true,
        "value": 120000
      },
      "dedupe_ttl": {
        "status": "defined-only",
        "value": 300000
      },
      "health_refresh": {
        "status": "defined-only",
        "value": 60000
      },
      "preauth_timeout": {
        "enforced": true,
        "value": 10000
      },
      "tick_interval": {
        "advertised_in_hello": true,
        "enforced": true,
        "value": 30000
      },
      "webui_stream_idle_grace": {
        "advertised_in_hello": true,
        "value": 630000
      }
    }
  }
}
