{
  "name": "@opensquilla/ui-tokens",
  "version": "0.1.0",
  "description": "Product-neutral design token contracts for OpenSquilla clients",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./foundation.css": "./dist/foundation.css",
    "./themes.css": "./dist/themes.css",
    "./theme-contract.json": "./dist/theme-contract.json",
    "./themes/*": "./dist/themes/*/tokens.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-assets.mjs && tsc -p tsconfig.json",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:cross-surface": "node scripts/check-cross-surface.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensquilla/opensquilla.git",
    "directory": "packages/ui-tokens"
  },
  "license": "Apache-2.0"
}
