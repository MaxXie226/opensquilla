{
  "name": "@opensquilla/client-sdk",
  "version": "0.1.0",
  "description": "Product-neutral WebSocket and HTTP client for the OpenSquilla Gateway contract",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract-coverage.json": "./contract-coverage.json"
  },
  "files": [
    "dist",
    "contract-coverage.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensquilla/opensquilla.git",
    "directory": "packages/client-sdk"
  },
  "license": "Apache-2.0"
}
